# Local Node evaluation (`npm run setup`, then `npm start`) uses this file.
MAILBRIDGE_CONFIG=./config/mailboxes.yaml
MAILBRIDGE_SECRET_DIR=./secrets
MAILBRIDGE_ID_KEY_FILE=mailbridge_id_hmac_key
MAILBRIDGE_LOG_LEVEL=info
# Sending remains off unless this exact value is changed after policy review.
MAILBRIDGE_ALLOW_SEND=false

# Docker Compose is an explicit production path. Run `npm run setup:production`,
# replace every OAuth/hostname placeholder and populate the subject allowlist,
# then run `npm run build` and validate with `npm run doctor:production` before
# starting the `production` profile.
# Compose keeps host secrets at 0700/0600. A network-disabled, one-shot init
# service copies them into a private named volume as UID/GID 10001 with mode
# 0400 (directory 0710); the long-running service mounts it read-only.
