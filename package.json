{
  "name": "@gexiro/mailbridge-mcp",
  "version": "1.1.1",
  "description": "Security-first, read-only email intelligence reference app for MCP and ChatGPT.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Gexiro Global Enterprises Ltd.",
  "homepage": "https://github.com/gexiro-global/mailbridge-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gexiro-global/mailbridge-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/gexiro-global/mailbridge-mcp/issues"
  },
  "keywords": [
    "mcp",
    "mcp-apps",
    "chatgpt",
    "email",
    "read-only",
    "security"
  ],
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "bin": {
    "mailbridge-mcp": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "secret-scan": "node scripts/secret-scan.mjs",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm run build && npm test && npm run secret-scan"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "express": "5.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.1.1",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
