{
  "name": "@gexiro/mailbridge-mcp",
  "version": "2.1.0",
  "description": "Self-hosted multi-mailbox ChatGPT App with read-only IMAP intelligence and opt-in Safe Send.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Gexiro Global Enterprises Ltd.",
  "homepage": "https://github.com/gexiro-global/mailbridge-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gexiro-global/mailbridge-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/gexiro-global/mailbridge-mcp/issues"
  },
  "keywords": [
    "mcp",
    "mcp-apps",
    "chatgpt",
    "email",
    "imap",
    "self-hosted",
    "safe-send",
    "security"
  ],
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "config/mailboxes.example.yaml",
    "config/mailboxes.production.example.yaml",
    "secrets/README.md",
    "docs",
    "scripts/setup.mjs",
    "scripts/provision-container-secrets.mjs",
    "Dockerfile",
    "docker-compose.yml",
    "README.md",
    "SECURITY.md",
    "PRIVACY.md",
    "ARCHITECTURE.md",
    "THREAT_MODEL.md",
    "SUPPORT.md",
    "TERMS.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "bin": {
    "mailbridge-mcp": "dist/index.js",
    "mailbridge": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/demo/startLocalDemo.ts",
    "dev:http": "tsx src/index.ts --transport http",
    "dev:stdio": "tsx src/index.ts --transport stdio",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "start": "node dist/index.js --transport http",
    "start:local": "node dist/demo/startLocalDemo.js",
    "start:safe-send-staging": "node dist/demo/startSafeSendStaging.js",
    "start:stdio": "node dist/index.js --transport stdio",
    "start:tunnel-stdio": "node dist/tunnel-stdio.js",
    "setup": "node scripts/setup.mjs",
    "setup:production": "node scripts/setup.mjs --production",
    "doctor": "node dist/cli.js doctor",
    "doctor:production": "node dist/cli.js --config ./config/mailboxes.production.yaml --environment production doctor",
    "configure:send": "node dist/maintenance/configureMailboxSend.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "secret-scan": "tsx scripts/secret-scan.ts",
    "smoke": "node dist/demo/smoke.js",
    "smoke:safe-send": "node dist/demo/safeSendSmoke.js",
    "check": "npm run typecheck && npm run build && npm test && npm run secret-scan"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "commander": "15.0.0",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "imapflow": "1.4.7",
    "jose": "6.2.10",
    "mailparser": "3.9.16",
    "nodemailer": "9.0.5",
    "pino": "10.3.1",
    "sanitize-html": "2.17.7",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/mailparser": "3.4.6",
    "@types/node": "26.3.0",
    "@types/nodemailer": "8.0.1",
    "@types/sanitize-html": "2.16.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
